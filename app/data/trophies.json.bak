      ]
    },
    {
      "id": 42,
      "name": "The Goodtime State",
      "description": "Explore all of Leonida.",
      "grade": "bronze",
      "hidden": false,
      "kind": "world",
      "count": 52,
      "missable": false,
      "guide": "Fully unfog the map (52 areas) \u2014 fly a plane over fogged areas.",
      "tip": "Fly a plane over fogged areas of the map. Each area you fly over will unfog. Alternatively, explore on foot or vehicle - discovering locations, landmarks, and completing activities all contribute to unfogging. Use the map regularly to track which areas remain hidden.",
