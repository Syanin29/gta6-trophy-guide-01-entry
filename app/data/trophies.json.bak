      ]
    },
    {
      "id": 39,
      "name": "Sneakthief",
      "description": "Rob a jewelry store without being detected.",
      "grade": "bronze",
      "hidden": false,
      "kind": "robberies",
      "count": null,
      "missable": false,
      "guide": "Rob a jewelry store via the back door with Snap Gun, find safe code note, loot unseen. After Chapter 4 mission \"Yasmani's Jewelry Jobs,\" enter a jewelry store via back door with Snap Gun, find safe code note, loot unseen.",
      "tip": "After Chapter 4 \"Yasmani's Jewelry Jobs,\" equip the Snap Gun gadget. Find a jewelry store with a back door entrance. Use the Snap Gun on security cameras and guards. The back door entry is key to avoiding detection. Follow the code note to open the safe quietly.",
      "sources": [
