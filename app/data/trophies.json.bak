    {
      "id": 14,
      "name": "A Long Road",
      "description": "Attain 100% Completion.",
      "grade": "gold",
      "hidden": false,
      "kind": "completion",
      "count": null,
      "missable": false,
      "guide": "Attain 100% completion in GTA VI. The true completion checklist appears under Progress>Stats after finishing the story. Story progress already counts toward this, and it is forgiving at around 60% true completion - many activities contribute automatically. Nothing within it is missable.",
      "tip": "Play naturally through the game and most activities will contribute. Check Progress>Stats regularly to track your percentage. You only need about 60% of the possible activities to reach 100% completion.",
      "sources": [
        "https://www.planetgta6.com/en/gta-6-trophies/",
        "https://www.powerpyx.com/gta-6-grand-theft-auto-vi-trophy-guide-roadmap/"
      ]
    },
    {
      "id": 15,
      "name": "Cunning Stunts",
      "description": "Complete 250 Stunts.",
      "grade": "silver",
      "hidden": false,
      "kind": "activities",
      "count": 250,
      "missable": false,
      "guide": "Perform 250 stunts across Leonida. Stunts include 130 jumps, 202 under-bridge tricks, 40 knife flights, and 25 base jumps. Under-bridge stunts are the fastest to perform - look for bridge structures across the map and jump from them while performing tricks. A new stunt counter tracks your progress.",
      "tip": "Focus on under-bridge stunts first as they're the quickest method. Look for bridges across the waterways of Leonida and practice the jump timing. Each successful under-bridge trick counts toward the 250 total.",
      "sources": [
        "https://www.planetgta6.com/en/gta-6-trophies/",
        "https://www.powerpyx.com/gta-6-grand-theft-auto-vi-trophy-guide-roadmap/"
      ]
    },
    {
      "id": 16,
      "name": "Master of None",
      "description": "Try each type of activity once.",
      "grade": "bronze",
      "hidden": false,
      "kind": "activities",
      "count": 9,
      "missable": false,
      "guide": "Try each of the 9 activity types available in GTA VI at least once. The 9 activity types are: Fishing, Hunting, Golf, Shooting Ranges, Pool, Basketball, Video Game, Race/Top Fun, and Stunt. Track your progress via Progress>Activities in the pause menu.",
      "tip": "Each activity type has its own mini-game or challenge. Try one of each - you can fish at any fishing spot, hunt wildlife, play golf at courses, shoot at ranges, play pool, basketball, arcade games, race at Top Fun locations, and perform stunts.",
      "sources": [
        "https://www.planetgta6.com/en/gta-6-trophies/",
        "https://www.powerpyx.com/gta-6-grand-theft-auto-vi-trophy-guide-roadmap/"
      ]
    },
    {
      "id": 17,
      "name": "The Shootist",
      "description": "Earn a gold medal in all Shooting Range challenges.",
      "grade": "silver",
      "hidden": false,
      "kind": "activities",
      "count": 42,
      "missable": false,
      "guide": "Earn gold medals in all 42 Shooting Range challenges across 12 ranges in Leonida. Each range has multiple challenge targets and scenarios that must be completed with gold ranking. The challenges test accuracy, speed, and target priority across different weapon types and distances.",
      "tip": "Practice each range's challenges repeatedly. Focus on target priority and reload timing. Headshot challenges are often the quickest to gold. Use the range's training mode to learn enemy patterns.",
      "sources": [
        "https://www.planetgta6.com/en/gta-6-trophies/",
        "https://www.powerpyx.com/gta-6-grand-theft-auto-vi-trophy-guide-roadmap/"
      ]
    },
    {
      "id": 18,
      "name": "Top Fun",
      "description": "Win a Top Fun Drone Race at every location.",
      "grade": "bronze",
      "hidden": false,
      "kind": "activities",
      "count": 14,
      "missable": false,
      "guide": "Win a Top Fun drone race at all 14 locations across Leonida. There are 42 total races (3 races per location). Each location has drone races that you must win to complete. Race against the drone opponents and finish in first place to claim the location.",
      "tip": "Learn the drone race tracks at each location. Memorize the turns and boost pad positions. Taking the optimal route with proper boost usage will help you finish first.",
      "sources": [
        "https://www.planetgta6.com/en/gta-6-trophies/",
        "https://www.powerpyx.com/gta-6-grand-theft-auto-vi-trophy-guide-roadmap/"
      ]
    },
    {
      "id": 19,
      "name": "Earn Cash, Not Kudos",
      "description": "Win 20 different races.",
      "grade": "bronze",
      "hidden": false,
      "kind": "activities",
      "count": 20,
      "missable": false,
      "guide": "Win 20 different races across Leonida. There are 40 unique race locations in the game. Races include various types including circuit races, point-to-point, and special event races. Each won race counts toward this trophy - you need 20 different race wins.",
      "tip": "Participate in Top Fun races across the map. You can replay races to accumulate wins. Mix of race types available - some are easier than others.",
      "sources": [
        "https://www.planetgta6.com/en/gta-6-trophies/",
        "https://www.powerpyx.com/gta-6-grand-theft-auto-vi-trophy-guide-roadmap/"
      ]
    },
    {
      "id": 20,
      "name": "Baited My Tackle",
      "description": "Beat Cal in a fishing challenge.",
      "grade": "bronze",
      "hidden": false,
      "kind": "activities",
      "count": null,
      "missable": false,
      "guide": "After Chapter 1 mission \"Feng Shui (Meet Cal)\", Cal texts a fishing spot. Follow his questline and beat him in a fishing challenge. Cal is a fishing rival who will challenge you to catch bigger fish than him.",
      "tip": "Complete the \"Feng Shui\" mission first to unlock Cal's fishing challenges. When fishing, aim for larger fish to beat Cal's weight. Use bait to attract bigger species.",
      "sources": [
        "https://www.planetgta6.com/en/gta-6-trophies/",
        "https://www.powerpyx.com/gta-6-grand-theft-auto-vi-trophy-guide-roadmap/"
      ]
    },
    {
      "id": 21,
      "name": "Stick Fiddler",
      "description": "Complete an arcade game.",
      "grade": "bronze",
      "hidden": false,
      "kind": "activities",
      "count": null,
      "missable": false,
      "guide": "Complete one of the 4 video games available in GTA VI. Three of them are found at home TVs from Chapter 1 onward, and one is available on arcade machines scattered across Leonida. Each game has multiple levels to complete.",
      "tip": "Three arcade games are accessible through homes after Chapter 1. The fourth is on arcade machines scattered across Leonida. Try each game's different levels - some are platformers, others are shooting or racing games.",
      "sources": [
        "https://www.planetgta6.com/en/gta-6-trophies/",
        "https://www.powerpyx.com/gta-6-grand-theft-auto-vi-trophy-guide-roadmap/"
      ]
    },
    {
      "id": 22,
      "name": "Road to Rehabilitation",
      "description": "Complete the final mission for Andy.",
      "grade": "bronze",
      "hidden": true,
      "kind": "side-story",
      "count": null,
      "missable": false,
      "guide": "Andy is a partner character available Lucia-only starting in Chapter 3 at Belville. Complete her 5 quest strand by accepting her missions from the free-roam menu. The final quest concludes her storyline. Andy's quests involve various tasks from deliveries to combat missions.",
      "tip": "Start Andy's questline early in Chapter 3 to ensure you have time to complete all 5 quests. Her quests are marked on the map with her icon. Complete them in order as they build on each other.",
      "sources": [
        "https://www.planetgta6.com/en/gta-6-trophies/",
        "https://www.powerpyx.com/gta-6-grand-theft-auto-vi-trophy-guide-roadmap/"
      ]
    },
    {
      "id": 23,
      "name": "This Was No Boat Accident",
      "description": "Complete the final mission for Kenton.",
      "grade": "bronze",
      "hidden": true,
      "kind": "side-story",
      "count": null,
      "missable": false,
      "guide": "Kenton is available starting in Chapter 1 at Key Lento. His strand involves 7 shipwreck treasure dives using a metal detector. Note: His strand is temporarily unavailable after Chapter 1 but returns in Chapters 2-3. Complete his quests when the marker is active.",
      "tip": "Start Kenton's questline in Chapter 1 at Key Lento. Use the metal detector to find shipwreck treasures. His strand returns in Chapters 2-3 if you miss it initially, but it's best to complete it when first available.",
      "sources": [
        "https://www.planetgta6.com/en/gta-6-trophies/",
        "https://www.powerpyx.com/gta-6-grand-theft-auto-vi-trophy-guide-roadmap/"
      ]
    },
    {
      "id": 24,
      "name": "The Lone Rider",
      "description": "Complete the final mission for Billy.",
      "grade": "bronze",
      "hidden": true,
      "kind": "side-story",
      "count": null,
      "missable": false,
      "guide": "Billy is available after Chapter 2 mission \"Coffee Break.\" His quest strand begins at Thrillbilly Mudclub in Kelly County. Complete his 5 quest strand involving various tasks and challenges. The final quest concludes his storyline.",
      "tip": "Start Billy's questline after completing \"Coffee Break\" in Chapter 2. His location is at Thrillbilly Mudclub in Kelly County. His quests involve outdoor activities and some combat encounters.",
      "sources": [
        "https://www.planetgta6.com/en/gta-6-trophies/",
        "https://www.powerpyx.com/gta-6-grand-theft-auto-vi-trophy-guide-roadmap/"
      ]
    },
    {
      "id": 25,
      "name": "Strangers & Freaks",
      "description": "Complete 8 mission strands for strangers across the state of Leonida.",
      "grade": "silver",
      "hidden": false,
      "kind": "side-story",
      "count": 8,
      "missable": false,
      "guide": "Complete 8 stranger/freak mission strands across Leonida. Confirmed stranger strands include Kirk, Kyle, Yago, and Pilot Pete. Each stranger has multiple quests - you need to complete 8 total mission strands (not individual quests) to earn this trophy. Some strands have 3-7 quests each.",
      "tip": "Accept stranger mission strands from the free-roam menu. Four confirmed strands are Kirk, Kyle, Yago, and Pilot Pete. Complete enough individual quests across these and other strands to reach 8 total strands completed. Check the progress in Pause>Challenges.",
      "sources": [
        "https://www.planetgta6.com/en/gta-6-trophies/",
        "https://www.powerpyx.com/gta-6-grand-theft-auto-vi-trophy-guide-roadmap/"
      ]
    },
    {
      "id": 26,
      "name": "Supply & Demand",
      "description": "Complete the final mission for Randy.",
      "grade": "bronze",
      "hidden": true,
      "kind": "side-story",
      "count": null,
      "missable": false,
      "guide": "Randy's mission strand becomes available after Chapter 3 mission \"Clonin' Keys.\" Deliver 16 wishlist sports cars using the Waink app. Scan cars with the Waink app and deliver them to the RK garage in West Vice City. The final mission concludes his storyline.",
      "tip": "Start Randy's questline after Chapter 3 \"Clonin' Keys.\" Use the Waink app to scan the 16 wishlist sports cars. The RK garage is located west of Vice City. Each delivered car counts toward the 16 total.",
      "sources": [
        "https://www.planetgta6.com/en/gta-6-trophies/",
        "https://www.powerpyx.com/gta-6-grand-theft-auto-vi-trophy-guide-roadmap/"
      ]
    },
    {
      "id": 27,
      "name": "Spin On This!",
      "description": "Complete the final mission for Tyrone.",
      "grade": "bronze",
      "hidden": true,
      "kind": "side-story",
      "count": null,
      "missable": false,
      "guide": "Tyrone is a Jason-only partner character available after Chapter 3 mission \"Here Kitty Kitty.\" His strand involves destroying Kitty Litter synthetic labs and completing the final \"Spin On This\" mission. This is a partner strand that only Jason can access.",
      "tip": "Complete Chapter 3 mission \"Here Kitty Kitty\" to unlock Tyrone's strand. Then destroy the Kitty Litter synthetic labs (marked on map) and complete the final Spin On This mission. This only works with Jason as the protagonist.",
      "sources": [
        "https://www.planetgta6.com/en/gta-6-trophies/",
        "https://www.powerpyx.com/gta-6-grand-theft-auto-vi-trophy-guide-roadmap/"
      ]
    },
    {
      "id": 28,
      "name": "Positive Mental Attitude",
      "description": "Meditate at every spot across Leonida.",
      "grade": "bronze",
      "hidden": false,
      "kind": "collectibles",
      "count": 18,
      "missable": true,
      "missableNote": "Meditate at every spot across Leonida. This meditation spot at Jason's house balcony with Lucia after \"Down to Earth\" disappears after Chapter 1.",
      "guide": "Find and meditate at all 18 meditation spots across Leonida (at 10 different locations). There is a meditation spot at Jason's house balcony with Lucia after the Chapter 1 mission \"Down to Earth\" that may count toward this trophy and disappears after Chapter 1. This is potentially missable - to be safe, perform the meditation at each spot and keep a manual save at each chapter start/end. The exact trigger for counting is still being confirmed.",
      "tip": "Meditation spots are marked on the map with a lotus icon. Visit each one and perform the meditation action. Enable Criminal Profile HUD notifications to track progress. Keep manual saves at chapter starts in case you need to revisit spots.",
      "sources": [
        "https://www.planetgta6.com/en/gta-6-trophies/",
        "https://www.powerpyx.com/gta-6-grand-theft-auto-vi-trophy-guide-roadmap/"
      ]
    },
    {
      "id": 29,
      "name": "Fair Game",
      "description": "Hunt a unique animal for Bret.",
      "grade": "bronze",
      "hidden": true,
      "kind": "side-story",
      "count": null,
      "missable": false,
      "guide": "Bret is a Jason-only partner character available after the Chapter 2 \"Coffee Break\" mission. His strand involves hunting a unique animal in Lummox County using a hunting rifle (Killtelligence SM-69). The specific hunt \"Veteran Hunted\" requires tracking and killing a unique animal target. 15 Target Decks must be completed as part of this strand.",
      "tip": "Start Bret's questline after Chapter 2 \"Coffee Break.\" His hunting strand takes place in Lummox County. Use the hunting rifle Killtelligence SM-69 for the unique animal hunts. Track animal footprints and trails to locate the unique targets. The 15 Target Decks are separate card-collecting challenges.",
      "sources": [
        "https://www.planetgta6.com/en/gta-6-trophies/",
        "https://www.powerpyx.com/gta-6-grand-theft-auto-vi-trophy-guide-roadmap/"
      ]
    },
    {
      "id": 30,
      "name": "Don't Touch My Deck",
      "description": "Complete 3 Collectible Card sets.",
      "grade": "silver",
      "hidden": false,
      "kind": "collectibles",
      "count": 3,
      "missable": false,
      "guide": "Complete 3 of the 18 collectible card sets found across Leonida. Card sets are scattered throughout the world and include landmarks, curiosities, sculptures, tags, and other collectibles. Each set has multiple cards to collect. Finding all cards in a set completes it. The game tracks progress via Progress>Challenges.",
      "tip": "Explore the map and look for card icon markers. Some card sets are near major landmarks, others are in hidden areas. The WAiNK scan (hold Up+R1) can help locate nearby collectibles. Focus on one set at a time - some cards are on hidden rooftops or underwater.",
      "sources": [
        "https://www.planetgta6.com/en/gta-6-trophies/",
        "https://www.powerpyx.com/gta-6-grand-theft-auto-vi-trophy-guide-roadmap/"
      ]
    },
    {
      "id": 31,
      "name": "You WAiNKer!",
      "description": "WAiNK It at 100 locations.",
      "grade": "silver",
      "hidden": false,
      "kind": "collectibles",
      "count": 100,
      "missable": false,
      "guide": "WAiNK scan 100 locations across Leonida including landmarks, curiosities, sculptures, and tags. Hold Up + R1 to activate the WAiNK app and scan surroundings. The game will mark locations you've scanned. Some locations are hidden or require specific viewpoints. This counts landmarks, curiosities, sculptures, and tags toward the 100 total.",
      "tip": "Use the WAiNK app frequently while exploring. Scan from different viewpoints to reveal hidden locations. Focus on uncovering new locations rather than re-scanning already-discovered ones. The map will progressively fill in as you scan 100 unique locations.",
      "sources": [
        "https://www.planetgta6.com/en/gta-6-trophies/",
        "https://www.powerpyx.com/gta-6-grand-theft-auto-vi-trophy-guide-roadmap/"
      ]
    },
    {
      "id": 32,
      "name": "One Last Thing",
      "description": "Complete 50 Challenges.",
      "grade": "bronze",
      "hidden": false,
      "kind": "activities",
      "count": 50,
      "missable": false,
      "guide": "Complete 50 of the 80 total challenges tracked in Progress>Challenges. Challenges include various activities like stunts, races, shooting range tests, and other skill-based tasks. The challenge list tracks your progress and shows how many remain. Some challenges overlap with other trophies like stunts and races.",
      "tip": "Check Progress>Challenges regularly to see the full list of 80 challenges. Prioritize challenges you haven't attempted yet. Some challenges naturally contribute to other trophies (like stunt counts or race wins).",
      "sources": [
        "https://www.planetgta6.com/en/gta-6-trophies/",
        "https://www.powerpyx.com/gta-6-grand-theft-auto-vi-trophy-guide-roadmap/"
      ]
    },
    {
      "id": 33,
      "name": "Hot Together",
      "description": "Lose a 4 star Wanted Level with your partner and escape the heat.",
      "grade": "bronze",
      "hidden": false,
      "kind": "partner",
      "count": null,
      "missable": false,
      "guide": "With partner, lose a 4-star wanted level and escape the heat zone. The train tunnel north of Ambrosia is an easy escape route - drive into the tunnel and the wanted level will dissipate. This also happens naturally during bank vault robberies when escaping with a partner.",
      "tip": "When you get a 4-star wanted level with your partner, head to the train tunnel north of Ambrosia. The tunnel provides immediate wanted level removal. Alternatively, entering a safe house or using Pay 'n' Spray also works.",
      "sources": [
        "https://www.planetgta6.com/en/gta-6-trophies/",
        "https://www.powerpyx.com/gta-6-grand-theft-auto-vi-trophy-guide-roadmap/"
      ]
    },
    {
      "id": 34,
      "name": "Retail Therapy",
      "description": "Rob 3 shops back-to-back with your partner without losing your Wanted Level.",
      "grade": "bronze",
      "hidden": false,
      "kind": "partner",
      "count": 3,
      "missable": false,
      "guide": "With partner, rob 3 shops in a row while keeping the wanted level. North Vice City jewelry stores are ideal after Chapter 3 mission \"Yasmani's Jewelry Jobs.\" The trophy pops ~30s after the 3rd shop robbery. Stay together as partners and avoid police attention between robberies.",
      "tip": "After Chapter 3 \"Yasmani's Jewelry Jobs,\" head to the jewelry stores in North Vice City. Rob each store sequentially with your partner. Keep moving between locations to maintain the wanted level. The trophy pops automatically after the 3rd successful robbery within ~30 seconds.",
      "sources": [
        "https://www.planetgta6.com/en/gta-6-trophies/",
        "https://www.powerpyx.com/gta-6-grand-theft-auto-vi-trophy-guide-roadmap/"
      ]
    },
    {
      "id": 35,
      "name": "Whip It Good",
      "description": "Discover 100 vehicles.",
      "grade": "bronze",
      "hidden": false,
      "kind": "collectibles",
      "count": 100,
      "missable": false,
      "guide": "Discover 100 vehicles using the Waink app across Leonida. There are 557 vehicles in the game, and 200 are needed for 100% completion. The Waink app (hold Up+R1) scans and marks vehicles you've discovered. Each unique vehicle discovered counts toward the 100 total. This includes cars, motorcycles, boats, and aircraft.",
      "tip": "Use the WAiNK app frequently while exploring. Scan vehicles you encounter on the road. Focus on finding new vehicle types rather than re-scanning the same ones. Some rare vehicles require specific locations or times of day.",
      "sources": [
        "https://www.planetgta6.com/en/gta-6-trophies/",
        "https://www.powerpyx.com/gta-6-grand-theft-auto-vi-trophy-guide-roadmap/"
      ]
    },
    {
      "id": 36,
      "name": "Gunslinger",
      "description": "Take down 5 enemies in a single use of Combat Focus.",
      "grade": "bronze",
      "hidden": false,
      "kind": "misc",
      "count": 5,
      "missable": false,
      "guide": "Take down 5 enemies in a single use of Combat Focus (L3+R3 while aiming). Combat Focus slows time during aiming. To earn this, you need to down 5 enemies with one activation. Buff focus by eating food or consuming Adrenaline. Gang operations are good spots for this - they have groups of enemies that count toward the 5 required.",
      "tip": "Engage in gang operations or ambushes where enemies cluster together. Use Combat Focus (L3+R3) and aim at groups of enemies. Food and Adrenaline items boost focus duration. Firing into a crowd of gang members with focus active can net the 5 down quickly.",
      "sources": [
        "https://www.planetgta6.com/en/gta-6-trophies/",
        "https://www.powerpyx.com/gta-6-grand-theft-auto-vi-trophy-guide-roadmap/"
      ]
    },
    {
      "id": 37,
      "name": "Catch Me If You Can",
      "description": "Make an unscheduled departure at VCIA.",
      "grade": "bronze",
      "hidden": true,
      "kind": "world",
      "count": null,
      "missable": false,
      "guide": "Steal a docked passenger plane at VCIA terminal E3/E4, take off, fly ~1km away.",
      "tip": "Go to VCIA terminal area. Enter a parked passenger plane. Line up on the runway and take off. Fly straight and level until you're about 1km (roughly 2-3 minute flight) from the terminal. The trophy pops when you're at the required distance.",
      "sources": [
        "https://www.planetgta6.com/en/gta-6-trophies/",
        "https://www.powerpyx.com/gta-6-grand-theft-auto-vi-trophy-guide-roadmap/"
      ]
    },
    {
      "id": 38,
      "name": "Challenging Tank",
      "description": "Kinda hot in these Rhinos.",
      "grade": "bronze",
      "hidden": true,
      "kind": "world",
      "count": null,
      "missable": false,
      "guide": "Steal a Rhino tank at Mile Zero Air Station (SW Mariana County), shoot enemies.",
      "tip": "Go to Mile Zero Air Station in southwest Mariana County. Steal the Rhino tank from the hangar. Use the tank's cannon to shoot enemies around the air station. Tanks are durable so you can take some fire while engaging targets.",
      "sources": [
