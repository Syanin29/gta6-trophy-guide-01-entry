      ]
    },
    {
      "id": 41,
      "name": "A Classic Blitz Play",
      "description": "Rob an Armored Truck and escape.",
      "grade": "bronze",
      "hidden": false,
      "kind": "robberies",
      "count": null,
      "missable": false,
      "guide": "Same Ch4 mission unlocks it; or blow an armored truck's rear door with a sticky bomb and escape the heat.",
      "tip": "After Chapter 4 \"That's Where The Money Is\u2026,\" watch for armored trucks spawning around Vice City. Equip sticky bombs and target the rear door of the truck. Blast it to open, grab the cash, and immediately head to a safe house or Pay 'n' Spray to lose the wanted level.",
      "sources": [
        "https://www.planetgta6.com/en/gta-6-trophies/",
