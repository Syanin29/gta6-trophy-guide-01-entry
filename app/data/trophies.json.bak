      ]
    },
    {
      "id": 40,
      "name": "Maximum Withdrawal",
      "description": "Rob 5 Bank Vaults and escape.",
      "grade": "silver",
      "hidden": false,
      "kind": "robberies",
      "count": 5,
      "missable": false,
      "guide": "After Ch4 \"That's Where The Money Is\u2026\"; tail security vans (Yasmani sells tips for $10,000), rob vault while open with partner; 8 vaults exist, need 5; instant 4 stars.",
      "tip": "After Chapter 4 \"That's Where The Money Is\u2026,\" use Yasmani's tips ($10,000 each) to learn vault locations. Tail the security vans to discover vault sites. Rob vaults when open - they have timed openings. Bring a partner for easier escape. The wanted level hits instantly at 4 stars after robbing.",
      "sources": [
